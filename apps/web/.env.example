# ---------------------------------------------------------------------------
# @bi-rem/web — customer portal environment
# Variables prefixed NEXT_PUBLIC_ are inlined into the browser bundle at build
# time and validated by src/env.ts. Server-only variables are read at runtime.
# ---------------------------------------------------------------------------

# Public base URL of the BI-Rem API as reachable from the browser (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:4000

# Display name used in titles and the UI shell.
NEXT_PUBLIC_APP_NAME=BI-Rem

# Public origin of this portal (used for absolute links in metadata). Optional.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only: API base URL used by Next route handlers / server components when it differs
# from the public URL (e.g. an internal Fly/Docker hostname). Defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=

# Server-only: force the `Secure` cookie flag (defaults to true in production).
AUTH_COOKIE_SECURE=
