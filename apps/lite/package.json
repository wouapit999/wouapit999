{
  "name": "@bi-rem/lite",
  "version": "0.1.0",
  "private": true,
  "description": "BI-Rem Lite — the whole BI-Rem programme in one small Next.js app (GitHub + Vercel + Neon)",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev -p 3002",
    "sync:roadmap": "node scripts/sync-roadmap.mjs",
    "build": "node scripts/sync-roadmap.mjs && next build",
    "start": "next start -p 3002",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "test:e2e:walkthroughs": "node tests/e2e/walkthroughs/run.mjs",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "vercel-build": "node scripts/sync-roadmap.mjs && prisma generate && prisma migrate deploy && tsx prisma/seed.ts && next build",
    "clean": "rm -rf .next .next-* out coverage test-results tests/e2e/.auth src/generated .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "jose": "^6.2.17",
    "next": "^16.4.5",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@bi-rem/config": "workspace:*",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
