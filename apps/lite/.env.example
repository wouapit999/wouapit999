# BI-Rem Lite — environment variables (validated with Zod in src/server/env.ts).
# Copy to apps/lite/.env for local development. Never commit real values.
# On Vercel set them in Project → Settings → Environment Variables (see DEPLOY.md).

# --- Database ---------------------------------------------------------------------------------

# Runtime connection. On Vercel use the Neon *pooled* URL — the host contains "-pooler" (the
# Vercel–Neon integration sets it). Paste it as Neon gives it; no "?pgbouncer=true" is needed.
DATABASE_URL=postgresql://birem:birem@localhost:5432/birem_lite

# Direct (non-pooled) URL used by `prisma migrate deploy` and the seed, at build time only.
# Falls back to DATABASE_URL. The Vercel–Neon integration sets it.
# DATABASE_URL_UNPOOLED=postgresql://birem:birem@localhost:5432/birem_lite

# Connections per server instance (1–50, default 5). Keep it small on serverless: every warm
# function instance owns its own pool, and the Neon pooler multiplexes them.
# DATABASE_POOL_MAX=5

# --- Secrets ----------------------------------------------------------------------------------

# >= 32 characters; signs session cookies. REQUIRED in production.
#   openssl rand -base64 48
AUTH_SECRET=

# 32 random bytes, base64. AES-256-GCM key for provider credentials, webhook and MFA secrets.
# REQUIRED in production. Losing it makes the stored secrets unreadable.
#   openssl rand -base64 32
ENCRYPTION_KEY=

# Key rotation (optional): the version written with new ciphertexts (default 1) and, as JSON,
# older keys that must still decrypt existing rows, e.g. {"1":"<old base64 key>"}.
# ENCRYPTION_KEY_VERSION=1
# ENCRYPTION_KEYS_PREVIOUS=

# --- Seed (runs on every deploy, idempotent) --------------------------------------------------

# Initial administrator, created once and never modified afterwards. The password is mandatory
# in production (the default below is public).
SEED_ADMIN_EMAIL=admin@bi-rem.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# "true" seeds demo staff, partners, customers, wallets and 30 days of transfers — every demo
# account has the public password ChangeMe123!, including demo staff. Use it only on a
# demonstration deployment. Default: true outside production, false in production.
# SEED_DEMO_DATA=true

# --- Application ------------------------------------------------------------------------------

NEXT_PUBLIC_APP_NAME=BI-Rem Lite

# Alternative Next.js output directory, so several builds / dev servers can run side by side.
# NEXT_DIST_DIR=.next

# Outside production, auth and API rate limits are relaxed ×20 so local test suites are not
# throttled. Set to 1 to apply the production limits locally.
# RATE_LIMIT_STRICT=1

# --- Set by the platform, read-only (do not define them yourself) ----------------------------
# NODE_ENV                                   development | test | production
# VERCEL, VERCEL_ENV                         every Vercel build and deployment — production AND
#                                            preview — gets the production rules: real secrets
#                                            are mandatory, the public seed password is refused
#                                            and demo data is opt-in (`vercel dev` is exempt)
# VERCEL_GIT_COMMIT_SHA, VERCEL_GIT_COMMIT_REF, VERCEL_REGION    shown on /status
# VERCEL_GIT_PROVIDER, VERCEL_GIT_REPO_OWNER, VERCEL_GIT_REPO_SLUG
#                                            /status links its guides (deploy guide, go-live
#                                            checklist) to the repository and commit deployed

# --- Tests only -------------------------------------------------------------------------------
# `pnpm test` runs with and without PostgreSQL. The integration suites create and drop databases
# of their own (birem_lite_t_…) on the first server named by TEST_DATABASE_ADMIN_URL,
# TEST_DATABASE_URL or DATABASE_URL, else on the local default below. The URL only locates the
# server and a role allowed to CREATE DATABASE — the database it names is never read or written.
# With no server reachable and none named, the database-backed files are skipped with a notice;
# a server that was named but cannot be used fails the run.
# TEST_DATABASE_URL=postgresql://birem:birem@localhost:5432/postgres
# TEST_DATABASE_ADMIN_URL=postgresql://birem:birem@localhost:5432/postgres   (same, wins; also used by test:e2e)
# REQUIRE_TEST_DATABASE=1  fail instead of skipping when no database is reachable (CI)
#
# PROPERTY_SEED=20261110   seed of the randomised ledger property test
#                          (tests/integration/adversarial-money.test.ts); set it to replay a run
#
# End-to-end suite (tests/e2e/env.ts):
# E2E_BASE_URL=            run against an already running instance instead of building one
# E2E_PORT=3210            port of the instance the suite starts
# E2E_DATABASE_NAME=birem_lite_e2e
# E2E_SKIP_BUILD=1         reuse the existing build
# E2E_KEEP_DATABASE=1      keep the database after the run
# E2E_PASSWORD=            demo password, if the instance was seeded with another one
# E2E_WALKTHROUGH_PORT=3220    port of the dev server started by test:e2e:walkthroughs
# E2E_WALKTHROUGH_DATABASE=birem_lite_walk   its database (and "<name>_tpl"); with the port and
#                              NEXT_DIST_DIR (default .next-walkthroughs) these let two runs
#                              of the walk-throughs work side by side
