# ---------------------------------------------------------------------------
# @bi-rem/api — environment variables (validated at boot by src/config/env.ts).
# The root .env is loaded first; this file lists every variable the API reads.
# Never commit real secrets.
# ---------------------------------------------------------------------------
NODE_ENV=development

# Postgres: DATABASE_URL is required; DATABASE_POOL_URL (Neon pooled endpoint) is
# preferred at runtime when set.
DATABASE_URL=postgresql://birem:birem@localhost:5432/birem?schema=public
DATABASE_POOL_URL=postgresql://birem:birem@localhost:5432/birem?schema=public

# Redis (BullMQ notifications queue, permission cache, throttling). Optional: when unset
# the API falls back to an in-process notification dispatcher and in-memory caches.
REDIS_URL=redis://localhost:6379

# HTTP
API_PORT=4000
API_BASE_URL=http://localhost:4000
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Portal URLs embedded in e-mails (password reset links, welcome messages).
CUSTOMER_PORTAL_URL=http://localhost:3000
ADMIN_PORTAL_URL=http://localhost:3001
APP_NAME=BI-Rem

# Auth. Secrets must be at least 32 characters (openssl rand -base64 48).
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
# Durations: <number><unit> with unit s|m|h|d.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Field-level encryption key (TOTP secrets, secret settings): 32 bytes, base64 or hex.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=Zm9vYmFyYmF6cXV4MTIzNDU2Nzg5MGFiY2RlZmdoaWo=

# Outbound e-mail (Mailpit locally). SMTP_USER/SMTP_PASS may be empty.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BI-Rem <no-reply@bi-rem.local>"

# Observability
LOG_LEVEL=debug
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
# Release identifier reported to Sentry; the Docker image sets it from the build arg.
GIT_SHA=
