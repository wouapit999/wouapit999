{
  "name": "@bi-rem/admin",
  "version": "0.1.0",
  "private": true,
  "description": "BI-Rem admin portal (Next.js 16 App Router)",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev --port 3001",
    "start": "next start --port 3001",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
