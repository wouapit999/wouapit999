# Copy to .env and fill in. Never commit a populated .env file.
# PostgreSQL (Neon / Vercel Postgres / Supabase / local). DIRECT_URL is the non-pooled URL used by migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/residenceflow"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/residenceflow"
# Random 32+ byte secret (openssl rand -base64 32)
AUTH_SECRET=
# Bearer secret Vercel Cron sends to /api/cron/* (openssl rand -hex 32)
CRON_SECRET=
APP_BASE_URL=http://localhost:3000
# Optional: SMTP email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Optional: SMS / payment providers (adapters in src/lib/payments, src/lib/notify)
SMS_PROVIDER=
SMS_API_KEY=
PAYMENT_PROVIDER=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
# Optional S3-compatible storage (default: documents stored in PostgreSQL)
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
DEFAULT_TIMEZONE=Africa/Douala
DEFAULT_CURRENCY=XAF
# Set to "true" only on a demo deployment to show the demo-accounts hint on the login page
NEXT_PUBLIC_DEMO_MODE=false
