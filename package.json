{
  "name": "bi-rem",
  "version": "0.1.0",
  "private": true,
  "description": "BI-Rem — pan-African remittance and mobile-money platform (monorepo)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @bi-rem/db generate",
    "db:migrate": "pnpm --filter @bi-rem/db migrate:deploy",
    "db:migrate:dev": "pnpm --filter @bi-rem/db migrate:dev",
    "db:seed": "turbo run seed --filter=@bi-rem/db",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "docs:check": "node docs/roadmap/tools/check-docs.mjs",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@mermaid-js/mermaid-cli": "^12.2.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  }
}
