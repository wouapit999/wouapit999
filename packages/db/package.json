{
  "name": "@bi-rem/db",
  "version": "0.1.0",
  "private": true,
  "description": "BI-Rem Prisma 7 data layer: schema v1, migrations, seed and the shared PrismaClient factory",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./permissions": {
      "types": "./dist/src/permissions.d.ts",
      "import": "./dist/src/permissions.js"
    },
    "./client": {
      "types": "./dist/generated/client/client.d.ts",
      "import": "./dist/generated/client/client.js"
    }
  },
  "files": [
    "dist",
    "prisma/schema.prisma",
    "prisma/migrations"
  ],
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "migrate:reset": "prisma migrate reset",
    "studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist generated coverage .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "dotenv": "^18.0.10",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12"
  }
}
