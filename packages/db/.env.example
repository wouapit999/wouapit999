# @bi-rem/db — variables read by prisma.config.ts and prisma/seed.ts.
# The root .env is loaded too when commands run from the repo root; this file only lists
# what is specific to the data layer. Never commit a real .env.

# Direct (non-pooled) connection used by the Prisma CLI for migrations and introspection.
DATABASE_URL=postgresql://birem:birem@localhost:5432/birem?schema=public
# Optional: on Neon, point this at the *direct* endpoint and DATABASE_URL at the pooled one.
# When set, prisma.config.ts prefers it for migrate/db commands.
# DIRECT_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/birem?sslmode=require

# Seed defaults (prisma/seed.ts). SEED_ADMIN_PASSWORD is mandatory when NODE_ENV=production.
SEED_ADMIN_EMAIL=admin@bi-rem.local
SEED_ADMIN_PASSWORD=ChangeMe123!
# Demo customer is only created when NODE_ENV != production.
SEED_CUSTOMER_EMAIL=customer@bi-rem.local
SEED_CUSTOMER_PASSWORD=Customer123!
