# ---------------------------------------------------------------------------
# BI-Rem root environment (local development)
# Copy to .env and adjust. Never commit real secrets. Production secrets live in
# the hosting provider's secret store (Vercel env, Fly secrets) — see
# docs/architecture/phase-1-implementation-notes.md (Environments & deployment).
#
# Every variable read by the code base is listed here; each workspace's own
# .env.example repeats the subset it reads (apps/api, apps/web, apps/admin,
# packages/db). The API loads this file when started from apps/api.
# ---------------------------------------------------------------------------
NODE_ENV=development

# Neon PostgreSQL (local docker-compose default below; Neon URL in staging/prod)
DATABASE_URL=postgresql://birem:birem@localhost:5432/birem?schema=public
# Neon pooled connection string (PgBouncer) used by the API at runtime
DATABASE_POOL_URL=postgresql://birem:birem@localhost:5432/birem?schema=public
# Optional: Neon *direct* endpoint preferred by the Prisma CLI (migrations) when set
# DIRECT_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/birem?sslmode=require

# Redis (queues, rate-limit, permission cache). Optional: the API falls back to
# in-process queues and in-memory caches when unset.
REDIS_URL=redis://localhost:6379

# API
API_PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Portal URLs embedded in e-mails (password reset links, welcome messages)
CUSTOMER_PORTAL_URL=http://localhost:3000
ADMIN_PORTAL_URL=http://localhost:3001
APP_NAME=BI-Rem

# Auth (generate with: openssl rand -base64 48)
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Field-level encryption key for secrets (32 bytes base64) — openssl rand -base64 32
ENCRYPTION_KEY=change-me-32-byte-base64-key====================

# Notifications
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="BI-Rem <no-reply@bi-rem.local>"

# Monitoring
LOG_LEVEL=debug
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
# Release identifier reported to Sentry (set from the build arg in the Docker image)
GIT_SHA=

# Frontends (NEXT_PUBLIC_* are inlined into the browser bundles at build time)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=BI-Rem
# Public origin of each portal (absolute links in metadata). Optional.
NEXT_PUBLIC_APP_URL=
# Admin portal only: environment badge in the topbar (sandbox | production)
NEXT_PUBLIC_ENV=sandbox
# Server-only: API base URL used by Next route handlers when it differs from the
# public one (internal Fly/Docker hostname). Defaults to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=
# Server-only: force the `Secure` cookie flag (defaults to true in production)
AUTH_COOKIE_SECURE=
# Admin portal only: timeout in ms for the dashboard probe of GET /health
HEALTH_TIMEOUT_MS=3000

# Database seed (pnpm db:seed). SEED_ADMIN_PASSWORD is mandatory when NODE_ENV=production;
# the demo customer is only created when NODE_ENV != production.
SEED_ADMIN_EMAIL=admin@bi-rem.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_CUSTOMER_EMAIL=customer@bi-rem.local
SEED_CUSTOMER_PASSWORD=Customer123!
