{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "globalEnv": ["NODE_ENV", "CI"],
  "globalDependencies": [".env", "tsconfig.base.json"],
  "tasks": {
    "generate": {
      "cache": false,
      "outputs": ["generated/**", "src/generated/**"]
    },
    "build": {
      "dependsOn": ["^build", "^generate", "generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["DATABASE_URL", "NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_APP_NAME", "NEXT_DIST_DIR"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^build", "^generate", "generate"]
    },
    "lint": {
      "dependsOn": ["^build", "^generate", "generate"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^generate", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "^generate", "generate"],
      "outputs": ["coverage/**"],
      "env": ["TEST_DATABASE_ADMIN_URL"]
    },
    "test:e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "env": [
        "E2E_BASE_URL",
        "E2E_PASSWORD",
        "E2E_PORT",
        "E2E_DATABASE_NAME",
        "E2E_SKIP_BUILD",
        "E2E_KEEP_DATABASE",
        "TEST_DATABASE_ADMIN_URL"
      ],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH", "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD"]
    },
    "seed": {
      "cache": false,
      "dependsOn": ["^build", "generate"],
      "env": [
        "DATABASE_URL",
        "DIRECT_URL",
        "SEED_ADMIN_EMAIL",
        "SEED_ADMIN_PASSWORD",
        "SEED_CUSTOMER_EMAIL",
        "SEED_CUSTOMER_PASSWORD",
        "DATABASE_URL_UNPOOLED",
        "SEED_DEMO_DATA",
        "AUTH_SECRET",
        "ENCRYPTION_KEY"
      ]
    },
    "clean": {
      "cache": false
    }
  }
}
